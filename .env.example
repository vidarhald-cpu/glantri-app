# DATABASE_URL below is a DISPOSABLE scratch database (`glantri_local_scratch_test`).
# It is deliberately NOT `localhost:5432/glantri`: that database is PROTECTED
# SHARED USER STATE holding irreplaceable playtest data, and copying this example to
# `.env` must never connect you to it.
#
#   Fresh local setup (primary checkout):  pnpm db:up && pnpm db:migrate
#     `db:migrate` creates the scratch database if it does not exist yet. It lives on
#     the same local PostgreSQL server (localhost:5432) as the protected database but
#     is a separate database; nothing here touches `glantri`.
#   Linked Builder/QA worktrees: never copy this file or the primary checkout `.env`.
#     Run `pnpm db:task:setup -- --task <issue>` and use the generated `.env.task`.
#   Pointing DATABASE_URL at the protected `localhost:5432/glantri` is a deliberate,
#     conscious operator act, never a default and never something to copy from this
#     file. Do it only in your own, uncommitted `.env`, only from the primary checkout,
#     and only after reading docs/dev-database.md (take `pnpm db:backup` first).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/glantri_local_scratch_test"

# DATABASE_URL_TEST is intentionally absent. Tests that use PostgreSQL require a
# disposable target whose database name ends in `_test`; never reuse DATABASE_URL. The example DATABASE_URL above also ends in `_test` only to
# mark it disposable; DATABASE_URL_TEST must still be a different database.

# Base-URL til API-tjenesten — brukes av frontend for alle API-kall.
# Produksjon: https://<din-api-app>.azurewebsites.net
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# URL til frontend-applikasjonen — brukes av API for CORS-tillating.
# Produksjon: https://<din-web-app>.azurewebsites.net
WEB_ORIGIN="http://localhost:3000"

# Private Campaign Artifact storage. Local is development/test only and must point
# outside the web public tree. Hosted environments use Azure managed identity.
ARTIFACT_STORAGE_PROVIDER="local"
ARTIFACT_LOCAL_ROOT="/tmp/glantri-artifacts-local"
# ARTIFACT_AZURE_ACCOUNT_URL="https://<account>.blob.core.windows.net"
# ARTIFACT_AZURE_CONTAINER="campaign-artifacts"

# Log-nivå for API: trace | debug | info | warn | error | fatal
# Produksjon default: info — development default: debug
LOG_LEVEL="debug"

# Application Insights — tilkoblingsstreng for Azure Monitor
# Hentes automatisk fra Key Vault i produksjon
APPLICATIONINSIGHTS_CONNECTION_STRING=""

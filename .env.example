# PROTECTED SHARED USER STATE: only use this URL from the normal primary checkout.
# Linked Builder/QA worktrees must run `pnpm db:task:setup -- --task <issue>` and
# use the generated .env.task; never copy this file or the primary checkout .env.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/glantri"

# DATABASE_URL_TEST is intentionally absent. Tests that use PostgreSQL require a
# disposable target whose database name ends in `_test`; never reuse DATABASE_URL.

# Trusted API origin used only by the Next/web server-side proxy. Browser clients
# always call /api on the web origin; never expose this value through NEXT_PUBLIC_*.
# Production: https://<your-api-app>.azurewebsites.net
API_UPSTREAM_URL="http://localhost:4000"

# URL til frontend-applikasjonen — brukes av API for CORS-tillating.
# Produksjon: https://<din-web-app>.azurewebsites.net
WEB_ORIGIN="http://localhost:3000"

# Log-nivå for API: trace | debug | info | warn | error | fatal
# Produksjon default: info — development default: debug
LOG_LEVEL="debug"

# Application Insights — tilkoblingsstreng for Azure Monitor
# Hentes automatisk fra Key Vault i produksjon
APPLICATIONINSIGHTS_CONNECTION_STRING=""

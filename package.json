{
  "name": "glantri-app",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.6.0",
  "engines": {
    "node": "22.23.x"
  },
  "scripts": {
    "bootstrap:test": "node --test scripts/bootstrap/*.test.mjs",
    "playtest:start": "sh scripts/playtest-runtime.sh start",
    "playtest:stop": "sh scripts/playtest-runtime.sh stop",
    "playtest:restart": "sh scripts/playtest-runtime.sh restart",
    "playtest:status": "sh scripts/playtest-runtime.sh status",
    "playtest:logs": "sh scripts/playtest-runtime.sh logs",
    "playtest:test": "node --test scripts/playtest/*.test.mjs",
    "dev": "node --import tsx scripts/database/guardedDatabaseCommand.ts dev",
    "build": "turbo build --force",
    "dev:full": "pnpm --filter @glantri/content build && pnpm dev",
    "typecheck": "tsc -p scripts/database/tsconfig.json --noEmit && turbo typecheck --force",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:check:changed": "node scripts/checkChangedFormatting.mjs",
    "lint": "eslint scripts/database scripts/recovery scripts/bootstrap scripts/playtest && turbo lint --force",
    "test": "pnpm recovery:historical:test && pnpm playtest:test && turbo test --force",
    "recovery:historical": "node --import tsx scripts/recovery/historicalPlaytestImporter.ts",
    "recovery:historical:migrate": "pnpm --filter @glantri/database exec prisma migrate deploy --config scripts/historicalPlaytestPrisma.config.ts",
    "recovery:historical:test": "vitest run scripts/recovery/*.test.ts",
    "coverage": "vitest run --coverage --passWithNoTests",
    "critical-effects:generate": "node scripts/generateCriticalEffectsTable.mjs --generate",
    "critical-effects:verify": "node scripts/generateCriticalEffectsTable.mjs --verify",
    "db:up": "node --import tsx scripts/database/guardedDatabaseCommand.ts up",
    "db:down": "node --import tsx scripts/database/guardedDatabaseCommand.ts down",
    "db:migrate": "node --import tsx scripts/database/guardedDatabaseCommand.ts migrate",
    "db:generate": "pnpm --filter @glantri/database db:generate",
    "db:backup": "node --import tsx scripts/database/guardedDatabaseCommand.ts backup",
    "db:seed": "node --import tsx scripts/database/guardedDatabaseCommand.ts seed",
    "db:reset:local": "node --import tsx scripts/database/guardedDatabaseCommand.ts reset",
    "db:task:setup": "node --import tsx scripts/database/worktreeDatabase.ts setup",
    "db:task:verify": "node --import tsx scripts/database/worktreeDatabase.ts verify",
    "db:task:migrate": "node --import tsx scripts/database/worktreeDatabase.ts migrate",
    "db:task:reset": "node --import tsx scripts/database/worktreeDatabase.ts reset",
    "db:task:seed": "node --import tsx scripts/database/worktreeDatabase.ts seed",
    "db:task:test": "node --import tsx scripts/database/worktreeDatabase.ts test",
    "db:task:exec": "node --import tsx scripts/database/worktreeDatabase.ts exec",
    "db:task:cleanup": "node --import tsx scripts/database/worktreeDatabase.ts cleanup"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@next/eslint-plugin-next": "^15.2.4",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "4",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "turbo": "^2.8.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^2.1.0"
  }
}

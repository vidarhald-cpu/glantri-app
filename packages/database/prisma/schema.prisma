generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EquipmentCategory {
  weapon
  shield
  armor
  gear
  valuables
}

enum CarryMode {
  equipped
  on_person
  backpack
  mount
  stored
}

enum StorageLocationType {
  equipped_system
  person_system
  backpack_system
  mount_system
  home
  camp
  boat
  wagon
  cache
  building
  other
}

enum LocationAvailabilityClass {
  with_you
  elsewhere
}

enum MaterialType {
  steel
  bronze
  wood
  leather
  cloth
  bone
  stone
  silver
  gold
  other
}

enum QualityType {
  standard
  extraordinary
}

enum SpecificityType {
  generic
  specific
}

enum ItemConditionState {
  intact
  worn
  damaged
  broken
  lost
}

enum CampaignStatus {
  draft
  active
  archived
}

enum ScenarioKind {
  combat
  social
  travel
  mixed
}

enum ScenarioStatus {
  draft
  prepared
  live
  completed
  archived
}

enum ScenarioCombatStatus {
  not_started
  in_progress
  paused
  ended
}

enum ScenarioParticipantSourceType {
  character
  entity
}

enum ScenarioParticipantRole {
  player_character
  npc
  monster
  animal
  neutral
  ally
  enemy
}

enum ScenarioParticipantJoinSource {
  gm_added
  player_joined
  imported_from_template
}

enum ScenarioRelationshipType {
  continues_from
}

enum ScenarioVisibility {
  hidden
  visible_to_all
  gm_only
}

enum CampaignAssetType {
  map
  image
  document
  handout
  drawing
}

enum ReusableEntityKind {
  npc
  monster
  animal
}

enum CampaignRosterSourceType {
  character
  reusableEntity
  template
}

enum CampaignRosterCategory {
  pc
  npc
  template
}

model Character {
  id               String                    @id @default(cuid())
  name             String
  level            Int                       @default(1)
  build            Json
  ownerId          String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  currentRetainedRevisionId String?          @unique
  owner            User?                     @relation(fields: [ownerId], references: [id])
  currentRetainedRevision CharacterRevision? @relation("CharacterCurrentRetainedRevision", fields: [currentRetainedRevisionId], references: [id], onDelete: SetNull)
  retainedRevisions CharacterRevision[]      @relation("CharacterRetainedRevisionHistory")
  retainedLedgerEvents CharacterLedgerEvent[]
  equipmentItems   CharacterEquipmentItem[]
  equipmentAggregate CharacterEquipmentAggregate?
  storageLocations CharacterStorageLocation[]
  loadouts         CharacterLoadout[]
  scenarioParticipants ScenarioParticipant[]
}

// The revision is the optimistic-concurrency token for the complete durable
// equipment state of one Character. Item rows, locations, and loadouts remain
// normalized records; this row makes their unit of consistency explicit.
model CharacterEquipmentAggregate {
  characterId String    @id
  revision    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model CharacterRevision {
  id                    String   @id
  characterId           String
  sequence              Int
  parentRevisionId      String?
  commandIdempotencyKey String
  commandDigest         String
  reason                String
  actorUserId           String?
  versionEnvelopeJson   Json
  stateJson             Json
  effectiveSkillsJson   Json
  revisionDigest        String
  migrationLineageJson  Json
  createdAt             DateTime @default(now())
  character             Character @relation("CharacterRetainedRevisionHistory", fields: [characterId], references: [id], onDelete: Cascade)
  currentForCharacter   Character? @relation("CharacterCurrentRetainedRevision")
  events                CharacterLedgerEvent[]

  @@unique([characterId, sequence])
  @@unique([characterId, commandIdempotencyKey])
  @@index([characterId, createdAt])
}

model CharacterLedgerEvent {
  id                        String   @id
  characterId               String
  characterRevisionId       String
  sequence                  Int
  idempotencyKey            String
  eventKind                 String
  phase                     String
  component                 String
  targetKind                String
  targetId                  String
  sourceKind                String
  sourceId                  String
  sourceLabel               String
  publicExplanation         String
  authority                 String
  actorUserId               String?
  visibility                String
  valueBefore               Int?
  valueAfter                Int?
  valueDelta                Int?
  economicsJson             Json?
  prerequisiteEvidenceJson  Json?
  protectedProvenanceJson   Json?
  versionEnvelopeJson       Json
  occurredAt                DateTime @default(now())
  character                 Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterRevision         CharacterRevision @relation(fields: [characterRevisionId], references: [id], onDelete: Cascade)

  @@unique([characterRevisionId, sequence])
  @@unique([characterId, idempotencyKey])
  @@index([characterId, occurredAt])
  @@index([targetKind, targetId])
}

model Weapon {
  id        String   @id @default(cuid())
  name      String
  baseOb    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Encounter {
  id                   String                         @id @default(cuid())
  name                 String
  campaignId           String?
  scenarioId           String?
  status               String                         @default("setup")
  sessionJson          Json?
  combatStorageMode    String                         @default("legacy")
  combatArchiveCount   Int                            @default(0)
  createdByUserId      String?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  activeCombatState    EncounterActiveCombatState?
  archivedCombatRounds EncounterArchivedCombatRound[]

  @@index([campaignId])
  @@index([scenarioId])
  @@index([scenarioId, updatedAt])
}

model EncounterActiveCombatState {
  encounterId   String    @id
  revision      DateTime
  stateJson     Json
  schemaVersion Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  encounter     Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([revision])
}

model EncounterArchivedCombatRound {
  id             String    @id @default(cuid())
  encounterId    String
  roundNumber    Int
  roundJson      Json
  sourceRevision DateTime
  schemaVersion  Int       @default(1)
  createdAt      DateTime  @default(now())
  encounter      Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@unique([encounterId, roundNumber])
  @@index([encounterId, roundNumber])
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  displayName String?
  passwordHash String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  campaigns   Campaign[]
  characters  Character[]
  createdAssets CampaignAsset[]
  artifactAuditEvents ArtifactAuditEvent[] @relation("ArtifactAuditActor")
  attachedArtifactReferences ScenarioArtifactReference[] @relation("ScenarioArtifactAttachedBy")
  publishedArtifactReferences ScenarioArtifactReference[] @relation("ScenarioArtifactPublishedBy")
  controlledScenarioParticipants ScenarioParticipant[] @relation("ScenarioParticipantController")
  reusableEntities ReusableEntity[]
  roles       UserRole[]
  scenarioEvents ScenarioEventLog[]
  sessions    Session[]
}

model Role {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     UserRole[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CanonicalContentSnapshot {
  key       String   @id
  content   Json
  revision  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CharacterEquipmentItem {
  id                    String             @id
  holderCharacterId     String?
  campaignContextId     String?
  templateId            String
  category              EquipmentCategory
  displayName           String?
  specificityType       SpecificityType
  quantity              Int
  isStackable           Boolean
  material              MaterialType
  quality               QualityType
  locationId            String?
  carryMode             CarryMode?
  previousLocationId    String?
  previousCarryMode     CarryMode?
  conditionState        ItemConditionState
  durabilityCurrent     Int?
  durabilityMax         Int?
  encumbranceOverride   Float?
  valueOverride         Float?
  itemFactsJson         Json
  notes                 String?
  isEquipped            Boolean?
  isFavorite            Boolean?
  acquiredFrom          String?
  statusTagsJson        Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  holderCharacter       Character?          @relation(fields: [holderCharacterId], references: [id], onDelete: SetNull)
  campaignContext       Campaign?           @relation(fields: [campaignContextId], references: [id], onDelete: SetNull)
  storageLocation       CharacterStorageLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([holderCharacterId])
  @@index([holderCharacterId, locationId])
  @@index([campaignContextId])
}

model CharacterStorageLocation {
  id                      String              @id
  characterId             String
  name                    String
  type                    StorageLocationType
  availabilityClass       LocationAvailabilityClass
  parentLocationId        String?
  isMobile                Boolean
  isAccessibleInEncounter Boolean
  notes                   String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  character               Character           @relation(fields: [characterId], references: [id], onDelete: Cascade)
  equipmentItems          CharacterEquipmentItem[]

  @@index([characterId])
  @@unique([characterId, name])
}

model CharacterLoadout {
  id                        String      @id
  characterId               String
  name                      String
  isActive                  Boolean
  wornArmorItemId           String?
  readyShieldItemId         String?
  activePrimaryWeaponItemId String?
  activeSecondaryWeaponItemId String?
  activeMissileWeaponItemId String?
  activeAmmoItemIds         String[]
  quickAccessItemIdsJson    Json
  notes                     String?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt
  character                 Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@index([characterId, isActive])
}

model Campaign {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String
  gmUserId    String
  status      CampaignStatus
  settingsJson Json
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  assets      CampaignAsset[]
  artifactAuditEvents ArtifactAuditEvent[]
  artifactReferences ScenarioArtifactReference[]
  equipmentItems CharacterEquipmentItem[]
  gmUser      User            @relation(fields: [gmUserId], references: [id], onDelete: Cascade)
  rosterEntries CampaignRosterEntry[]
  scenarioRelationships ScenarioRelationship[]
  scenarios   Scenario[]
}

model Scenario {
  id            String             @id @default(cuid())
  campaignId    String
  name          String
  description   String
  kind          ScenarioKind
  status        ScenarioStatus
  mapAssetId    String?
  liveStateJson Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  campaign      Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  eventLogs     ScenarioEventLog[]
  mapAsset      CampaignAsset?     @relation("ScenarioMapAsset", fields: [mapAssetId], references: [id], onDelete: SetNull)
  participants  ScenarioParticipant[]
  relationshipsFrom ScenarioRelationship[] @relation("ScenarioRelationshipFrom")
  relationshipsTo   ScenarioRelationship[] @relation("ScenarioRelationshipTo")
  artifactReferences ScenarioArtifactReference[]

  @@unique([campaignId, id])
  @@index([campaignId])
  @@index([campaignId, status])
}

model ScenarioRelationship {
  id             String                   @id @default(cuid())
  campaignId     String
  fromScenarioId String
  toScenarioId   String
  relationType   ScenarioRelationshipType
  sortOrder      Int?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  campaign       Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  fromScenario   Scenario                 @relation("ScenarioRelationshipFrom", fields: [fromScenarioId], references: [id], onDelete: Cascade)
  toScenario     Scenario                 @relation("ScenarioRelationshipTo", fields: [toScenarioId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([fromScenarioId])
  @@index([toScenarioId])
  @@index([campaignId, relationType])
}

model ReusableEntity {
  id          String             @id @default(cuid())
  gmUserId    String
  name        String
  kind        ReusableEntityKind
  description String?
  notes       String?
  snapshotJson Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  gmUser      User               @relation(fields: [gmUserId], references: [id], onDelete: Cascade)
  scenarioParticipants ScenarioParticipant[]

  @@index([gmUserId])
}

model ScenarioParticipant {
  id          String                        @id @default(cuid())
  scenarioId  String
  sourceType  ScenarioParticipantSourceType
  characterId String?
  entityId    String?
  role        ScenarioParticipantRole
  controlledByUserId String?
  factionId   String?
  tacticalGroupId String?
  roleTag     String?
  displayOrder Int?
  joinSource  ScenarioParticipantJoinSource
  initiativeSlot Int?
  positionJson Json?
  visibilityOverridesJson Json?
  stateJson   Json
  snapshotJson Json
  isActive    Boolean                       @default(true)
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  character   Character?                    @relation(fields: [characterId], references: [id], onDelete: SetNull)
  controlledByUser User?                    @relation("ScenarioParticipantController", fields: [controlledByUserId], references: [id], onDelete: SetNull)
  entity      ReusableEntity?               @relation(fields: [entityId], references: [id], onDelete: SetNull)
  scenario    Scenario                      @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  eventLogs   ScenarioEventLog[]

  @@index([scenarioId])
  @@index([characterId])
  @@index([entityId])
  @@index([controlledByUserId])
  @@index([scenarioId, controlledByUserId])
  @@index([scenarioId, factionId])
  @@index([scenarioId, tacticalGroupId])
}

model CampaignAsset {
  id          String             @id @default(cuid())
  campaignId  String
  type        CampaignAssetType
  title       String
  description String?
  storageUrl  String
  mimeType    String?
  visibility  ScenarioVisibility
  artifactKind String?
  altText String?
  originalFilename String?
  provenanceKind String?
  sourceLabel String?
  sourceUri String?
  mediaTypeDetected String?
  byteSize BigInt?
  sha256Digest String?
  metadataVersion Int @default(1)
  lifecycleState String @default("active")
  audience String @default("gm_private")
  storageProvider String @default("legacy")
  storageKey String?
  storageState String @default("legacy_reference")
  storageDeletePending Boolean @default(false)
  deletedAt DateTime?
  createdByUserId String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  campaign    Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdByUser User             @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  mappedScenarios Scenario[]     @relation("ScenarioMapAsset")
  artifactReferences ScenarioArtifactReference[]
  auditEvents ArtifactAuditEvent[]

  @@unique([campaignId, id])
  @@index([campaignId])
}

model ScenarioArtifactReference {
  id String @id @default(cuid())
  campaignId String
  scenarioId String
  artifactId String
  state String @default("attached")
  titleSnapshot String
  captionSnapshot String?
  altTextSnapshot String?
  sortOrder Int?
  attachedByUserId String
  publishedByUserId String?
  version Int @default(1)
  publishedAt DateTime?
  withdrawnAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scenario Scenario @relation(fields: [campaignId, scenarioId], references: [campaignId, id], onDelete: Cascade)
  artifact CampaignAsset @relation(fields: [campaignId, artifactId], references: [campaignId, id], onDelete: Cascade)
  attachedByUser User @relation("ScenarioArtifactAttachedBy", fields: [attachedByUserId], references: [id], onDelete: Restrict)
  publishedByUser User? @relation("ScenarioArtifactPublishedBy", fields: [publishedByUserId], references: [id], onDelete: Restrict)

  @@unique([scenarioId, artifactId])
  @@index([campaignId, artifactId, state])
  @@index([campaignId, scenarioId, state])
}

model ArtifactAuditEvent {
  id String @id @default(cuid())
  campaignId String
  artifactId String
  actorUserId String
  action String
  metadataJson Json?
  createdAt DateTime @default(now())
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  artifact CampaignAsset @relation(fields: [campaignId, artifactId], references: [campaignId, id], onDelete: Cascade)
  actorUser User @relation("ArtifactAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([campaignId, artifactId, createdAt])
}

model CampaignRosterEntry {
  id              String                   @id @default(cuid())
  campaignId      String
  sourceType      CampaignRosterSourceType
  sourceId        String
  category        CampaignRosterCategory
  labelSnapshot   String?
  notes           String?
  createdByUserId String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  campaign        Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([sourceType, sourceId])
  @@unique([campaignId, sourceType, sourceId])
}

model CampaignBlackboardEntry {
  id                          String   @id
  campaignId                  String
  category                    String
  createdByUserId             String
  createdByLabelSnapshot      String
  state                       String
  entryVersion                Int
  currentRevisionNumber       Int
  stateChangedByUserId        String
  stateChangedByLabelSnapshot String
  stateChangedAt              DateTime
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@unique([campaignId, id], map: "bb_entry_campaign_id_id_key")
  @@unique([campaignId, id, category], map: "bb_entry_campaign_id_id_category_key")
  @@index([campaignId, state])
}

model CampaignBlackboardEntryRevision {
  campaignId               String
  entryId                  String
  revisionNumber           Int
  category                 String
  changeKind               String
  actorUserId              String
  actorLabelSnapshot       String
  changedAt                DateTime @default(now())
  title                    String
  clueFact                 String?
  contextText              String?
  documentText             String?
  imageCaption             String?
  sourceArtifactIdSnapshot String?
  sourceArtifactKind       String?
  sourceArtifactTitle      String?
  sourceArtifactAltText    String?
  sourceArtifactMediaType  String?
  recapText                String?
  approvedByUserId         String?
  approvedByLabelSnapshot  String?
  approvedAt               DateTime?

  @@id([campaignId, entryId, revisionNumber], map: "bb_revision_pkey")
  @@index([campaignId, entryId, changedAt])
}

model CampaignBlackboardEntryEvent {
  campaignId         String
  entryId            String
  entryVersion       Int
  action             String
  actorUserId        String
  actorLabelSnapshot String
  occurredAt         DateTime @default(now())
  revisionNumber     Int?

  @@id([campaignId, entryId, entryVersion], map: "bb_entry_event_pkey")
  @@index([campaignId, entryId, revisionNumber], map: "bb_entry_event_revision_idx")
}

model CampaignBlackboardArtifactSourceLink {
  campaignId     String
  entryId        String
  revisionNumber Int
  artifactId     String

  @@id([campaignId, entryId, revisionNumber], map: "bb_artifact_source_link_pkey")
  @@index([campaignId, artifactId])
}

model CampaignBlackboardDetailUnitLineage {
  campaignId String
  entryId    String
  unitKey    String

  @@id([campaignId, entryId, unitKey], map: "bb_unit_lineage_pkey")
}

model CampaignBlackboardDetailUnitVersion {
  campaignId             String
  entryId                String
  unitKey                String
  unitVersion            Int
  labelSnapshot          String?
  detailText             String
  createdByUserId        String
  createdByLabelSnapshot String
  createdAt              DateTime @default(now())

  @@id([campaignId, entryId, unitKey, unitVersion], map: "bb_unit_version_pkey")
}

model CampaignBlackboardRevisionDetailUnit {
  campaignId     String
  entryId        String
  revisionNumber Int
  unitKey        String
  unitVersion    Int
  sortOrder      Int

  @@id([campaignId, entryId, revisionNumber, unitKey], map: "bb_revision_unit_pkey")
  @@unique([campaignId, entryId, revisionNumber, unitKey, unitVersion], map: "bb_revision_unit_exact_key")
  @@unique([campaignId, entryId, revisionNumber, sortOrder], map: "bb_revision_unit_sort_key")
}

model CampaignBlackboardDetailGrantStream {
  campaignId                 String
  entryId                    String
  targetCharacterIdSnapshot String
  unitKey                    String
  unitVersion                Int
  liveCharacterId            String?
  state                      String
  streamVersion              Int
  currentEntryRevisionNumber Int

  @@id([campaignId, entryId, targetCharacterIdSnapshot, unitKey, unitVersion], map: "bb_grant_stream_pkey")
  @@index([liveCharacterId])
}

model CampaignBlackboardDetailGrantEvent {
  campaignId                    String
  entryId                       String
  targetCharacterIdSnapshot     String
  unitKey                       String
  unitVersion                   Int
  streamVersion                 Int
  resultState                   String
  entryRevisionNumber           Int
  actorUserId                   String
  actorLabelSnapshot            String
  targetCharacterLabelSnapshot String
  occurredAt                    DateTime @default(now())

  @@id([campaignId, entryId, targetCharacterIdSnapshot, unitKey, unitVersion, streamVersion], map: "bb_grant_event_pkey")
  @@unique([campaignId, entryId, targetCharacterIdSnapshot, unitKey, unitVersion, streamVersion, resultState, entryRevisionNumber], map: "bb_grant_event_head_key")
}

model CampaignBlackboardLayout {
  campaignId    String   @id
  layoutVersion Int
  updatedAt     DateTime @updatedAt
}

model CampaignBlackboardPlacement {
  campaignId             String
  entryId                String
  x                      Int
  y                      Int
  width                  Int
  height                 Int
  layer                  Int
  groupId                String?
  rowVersion             Int
  updatedByUserId        String
  updatedByLabelSnapshot String
  updatedAt              DateTime @updatedAt

  @@id([campaignId, entryId], map: "bb_placement_pkey")
  @@index([campaignId, layer, entryId])
  @@index([campaignId, groupId])
}

model ScenarioEventLog {
  id            String   @id @default(cuid())
  scenarioId     String
  roundNumber    Int?
  phase          Int?
  eventType      String
  actorUserId    String?
  participantId  String?
  summary        String
  payloadJson    Json?
  createdAt      DateTime @default(now())
  actorUser      User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  participant    ScenarioParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  scenario       Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId])
  @@index([participantId])
  @@index([actorUserId])
}

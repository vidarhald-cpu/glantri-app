{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "API_HOST",
        "API_PORT",
        "ARTIFACT_E2E_STORAGE_ENABLED",
        "ARTIFACT_LOCAL_ROOT",
        "DATABASE_URL",
        "DATABASE_URL_TEST",
        "GLANTRI_*",
        "LOG_LEVEL",
        "NEXT_PUBLIC_*",
        "NODE_ENV",
        "WEB_HOST",
        "WEB_ORIGIN",
        "WEB_PORT"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "build/**", "coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "db:generate": {
      "cache": false
    }
  }
}
